        ],
        "responses": {
          "200": {
            "description": "Game added successfully",
            "schema": {
              "$ref": "#/definitions/UserGames"
            }
          },
          "400": {
            "description": "Invalid input or game already in preferences",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "User not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/users/games/{gameId}": {
      "delete": {
        "tags": ["Games"],
        "summary": "Remove a preferred game",
        "description": "Removes a game from the authenticated user's preferred games list",
        "parameters": [
          {
            "name": "gameId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Game title or index in the array"
          }
        ],
        "responses": {
          "200": {
            "description": "Game removed successfully",
            "schema": {
              "$ref": "#/definitions/UserGames"
            }
          },
          "400": {
            "description": "Invalid input",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "User or game not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
