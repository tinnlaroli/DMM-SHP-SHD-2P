              "$ref": "#/definitions/UserGames"
            }
          },
          "403": {
            "description": "Profile is private",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "User not found",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Server error",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/users/games": {
      "post": {
        "tags": ["Games"],
        "summary": "Add a preferred game",
        "description": "Adds a game to the authenticated user's preferred games list",
        "parameters": [
          {
            "name": "game",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GameAdd"
